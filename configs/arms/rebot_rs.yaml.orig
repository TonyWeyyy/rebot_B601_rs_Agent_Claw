# Real reBot DevArm B601, RobStride build, on can0 @ 1 Mbps.
#
# Before first use:
#   sudo ip link set can0 up type can bitrate 1000000
# and make sure motorbridge-gateway / MotorBridge Studio are NOT running
# (host-id 0xFD conflict).
type: rebot_rs
# sdk_path: parent dir of the `reBotArm_control_py` Python package
# (so `from reBotArm_control_py.actuator import RebotArm` works).
sdk_path: /home/seeed/reBotArm_control_py
# hw_yaml: file name resolved relative to <sdk_path>/config/
hw_yaml: rebotarm_rs.yaml
model: ${assets}/urdf/00-arm-rs_asm-v3/urdf/00-arm-rs_asm-v3.urdf
# Assets are mirrored vs. the SDK/hardware convention (q_local = -q_asset).
joint_signs: [-1, -1, -1, -1, -1, -1]
ee_frame: gripper_end
n_joints: 6
# Home pose: TCP at [0.25, 0, 0.35] with pitch=50° and J6 pre-set to -81°.
# Pre-positions wrist for top-down grasps; max joint delta to pregrasp: 51.4°.
home_q: [0.0, 1.2251, 1.9437, -1.5912, 0.0, -1.41]

# MIT gains per joint (null = use the SDK's rebotarm_rs.yaml values).
mit_kp: null
mit_kd: null

gripper:
  # RS gripper (rs-00 + rack-pinion): counterclockwise=false means
  # positive angle = open, negative = close direction.
  # Based on rebot_grasp/config/default.yaml RS config.
  open_pos: 5.0    # rad (fully open)
  closed_pos: 0.0  # rad (fully closed)
  max_width_m: 0.09
  kp: 6.0
  kd: 0.4

# Settling
settle_tol: 0.08  # rad (4.6 deg) - increased from 0.05 to handle oscillation
